{
  "name": "bossing",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicació per comparar preus de supermercats i optimitzar la compra",
  "keywords": [
    "supermarket",
    "price-comparison",
    "shopping",
    "optimization"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @bossing/database migrate",
    "db:seed": "pnpm --filter @bossing/database seed",
    "db:studio": "pnpm --filter @bossing/database studio",
    "scrape": "pnpm --filter @bossing/scrapers run scrape",
    "test:mercadona-api": "pnpm --filter @bossing/scrapers run test:mercadona-api",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.0.4",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-module-utils": "^2.12.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0-canary-7118f5dd7-20230705",
    "eslint-scope": "^7.2.2",
    "eslint-visitor-keys": "^3.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frolesti/bossing.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/frolesti/bossing/issues"
  },
  "homepage": "https://github.com/frolesti/bossing#readme"
}
