# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://bossing:bossing@localhost:5432/bossing
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Scraping
SCRAPE_INTERVAL_HOURS=6
MAX_CONCURRENT_SCRAPERS=3

# Translation (Google Gemini — aistudio.google.com/apikey)
# Usa l'API nativa de Gemini (gratuït amb API key)
# Sense clau, les traduccions no funcionaran (cerca en català sense traducció)
OPENAI_API_KEY=your_google_ai_api_key_here
AI_MODEL=gemini-2.5-flash

# Geolocation
DEFAULT_SEARCH_RADIUS_KM=10
MAX_SEARCH_RADIUS_KM=50
